# The production server's settings, loaded into Fly with `fly secrets import`.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Then replace every <...>. deploy/.env is ignored by git and by the Docker build.
# No quotes around values and no spaces around "=". PORT, INTERNAL_PORT, HOST and
# REPOWIKI_MODE are set in deploy/fly.server.toml; REPOWIKI_ENGINE_VERSION is passed
# with --env at each deploy. The server refuses to start if any value below is missing.

# Where the two halves of the site live: public pages, and the signed-in app.
# https, no path, no port, different hosts.
PUBLIC_ORIGIN=https://repowiki.app
APP_ORIGIN=https://app.repowiki.app

# Neon: the direct connection string (connection pooling off), keeping ?sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<host>.us-east-1.aws.neon.tech/neondb?sslmode=require

# Encrypts stored GitHub tokens. Make it once with `openssl rand -base64 32` and keep a
# copy somewhere safe: changing it signs everyone out.
TOKEN_KEY=<output of openssl rand -base64 32>

# The GitHub OAuth app. Homepage https://app.repowiki.app, callback
# https://app.repowiki.app/auth/github/callback.
GITHUB_CLIENT_ID=<client id>
GITHUB_CLIENT_SECRET=<client secret>

# An API key from the repowiki-hosted workspace in the Anthropic console.
ANTHROPIC_API_KEY=<sk-ant-...>

# Cloudflare R2: the bucket and an Object Read & Write token scoped to it.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=repowiki
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>

# Fly: the token from `fly tokens create deploy -a repowiki-workers`, the worker app,
# the worker image the deploy pushes, and the server's private address for workers.
FLY_API_TOKEN=<FlyV1 ...>
FLY_WORKER_APP=repowiki-workers
WORKER_IMAGE=registry.fly.io/repowiki-workers:v1
INTERNAL_URL=http://repowiki.internal:8788

# GitHub logins allowed to sign up, comma-separated. Empty admits no one new.
SIGNUP_ALLOWLIST=seanpatrickmay
