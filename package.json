{
  "name": "repowiki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "tracker:seed": "node scripts/tracker/run.ts",
    "index:repo": "node scripts/index-repo.ts",
    "manifest:build": "node --env-file=.env scripts/manifest-build.ts",
    "wiki:build": "node --env-file-if-exists=.env scripts/wiki-build.ts",
    "wiki:check": "node scripts/wiki-check.ts",
    "wiki:export": "node scripts/wiki-export.ts",
    "wiki:update": "node --env-file-if-exists=.env scripts/wiki-update.ts",
    "wiki:replay": "node --env-file-if-exists=.env scripts/wiki-replay.ts",
    "wiki:inflight": "node --env-file-if-exists=.env scripts/wiki-inflight.ts",
    "wiki:people": "node --env-file-if-exists=.env scripts/wiki-people.ts",
    "people:suggest": "node scripts/people-suggest.ts",
    "eval:run": "node --env-file-if-exists=.env scripts/eval-run.ts",
    "eval:report": "node scripts/eval-report.ts",
    "eval:accuracy": "node scripts/eval-accuracy.ts",
    "cassettes:record": "REPOWIKI_CASSETTE=record node --env-file=.env node_modules/vitest/vitest.mjs run",
    "site:build": "node packages/site/src/cli.ts build",
    "site:preview": "node packages/site/src/cli.ts preview",
    "site:demo": "node packages/site/src/demo.ts",
    "hosted:serve": "REPOWIKI_MODE=production node packages/server/src/main.ts",
    "hosted:dev": "REPOWIKI_MODE=development node --env-file-if-exists=.env packages/server/src/main.ts",
    "hosted:demo": "REPOWIKI_MODE=demo node packages/server/src/main.ts",
    "hosted:local": "REPOWIKI_MODE=development DATA_DIR=${DATA_DIR:-$HOME/.repowiki/hosted-local/data} node packages/server/src/main.ts",
    "hosted:worker": "node packages/worker/src/main.ts",
    "hosted:profile": "node scripts/hosted-profile.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@repowiki/core": "workspace:*",
    "@repowiki/engine": "workspace:*",
    "@repowiki/eval": "workspace:*",
    "@repowiki/hosted": "workspace:*",
    "@repowiki/llm": "workspace:*",
    "@repowiki/query": "workspace:*",
    "@repowiki/server": "workspace:*",
    "@repowiki/worker": "workspace:*",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
