---
import { getSite } from "../site.ts";

interface Props {
  /** Shown in the browser tab as "<title> - <repo> wiki". */
  title: string;
}

const { title } = Astro.props;
const { wiki } = getSite();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - {wiki.repo} wiki</title>
  </head>
  <body>
    <main id="content">
      <slot />
    </main>
  </body>
</html>
