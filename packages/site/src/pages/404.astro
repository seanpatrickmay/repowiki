---
import Layout from "../layouts/Layout.astro";
import { getSite } from "../site.ts";
import { withBase } from "../urls.ts";

const { wiki } = getSite();
---
<Layout title="Page not found">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <h1 class="page-title">Page not found</h1>
  <p>There is no article at this address in the {wiki.repo} wiki.</p>
  <p>
    You can <a href={withBase("/search/")}>search</a> for it, or browse
    <a href={withBase("/special/all-pages/")}>All articles</a>.
  </p>
</Layout>
