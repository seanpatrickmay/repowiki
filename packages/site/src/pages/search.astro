---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../urls.ts";
---
<Layout title="Search">
  <Fragment slot="head">
    <link rel="stylesheet" href={withBase("/pagefind/pagefind-ui.css")} />
    <meta name="robots" content="noindex" />
  </Fragment>
  <h1 class="page-title">Search</h1>
  <div id="search"></div>
  <noscript><p>Search needs JavaScript. <a href={withBase("/special/all-pages/")}>All articles</a> lists every article.</p></noscript>
  <script is:inline src={withBase("/pagefind/pagefind-ui.js")}></script>
  <script>
    import "../client/search.ts";
  </script>
</Layout>
