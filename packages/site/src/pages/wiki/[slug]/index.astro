---
import Article from "../../../components/Article.astro";
import { historyHref } from "../../../history.ts";
import Layout from "../../../layouts/Layout.astro";
import { pageFor, type WikiRoute, wikiRoutes } from "../../../routes.ts";
import { getSite } from "../../../site.ts";

export function getStaticPaths() {
  return wikiRoutes(getSite()).map((route) => ({ params: { slug: route.slug }, props: { route } }));
}

interface Props {
  route: WikiRoute;
}

const { route } = Astro.props;
const site = getSite();
const page = pageFor(site, route);
const history = historyHref(site, route.slug);
---
{page.kind === "article" ? (
  <Layout title={page.view.title}>
    <Article view={page.view} indexed={true} />
  </Layout>
) : page.kind === "redirect" ? (
  <Layout title={page.title}>
    <Fragment slot="head">
      {page.refresh !== null && <meta http-equiv="refresh" content={page.refresh} />}
      {page.target.href !== null && <link rel="canonical" href={page.target.href} />}
      <meta name="robots" content="noindex" />
    </Fragment>
    <h1 class="page-title">{page.title}</h1>
    <p class="redirect-target">
      Redirect to:
      {page.target.href === null ? (
        <span>{page.target.title}</span>
      ) : (
        <a class="wikilink" href={page.target.href}>{page.target.title}</a>
      )}
    </p>
    {history !== null && <p><a href={history}>View history</a></p>}
  </Layout>
) : (
  <Layout title={page.title}>
    <h1 class="page-title">{page.title}</h1>
    <p><b>{page.title}</b> may refer to:</p>
    <ul class="dab-list">
      {page.entries.map((entry) => (
        <li>
          {entry.href === null ? <span>{entry.title}</span> : <a class="wikilink" href={entry.href}>{entry.title}</a>}
          {entry.summaryHtml !== null && <span class="dab-summary" set:html={entry.summaryHtml} />}
        </li>
      ))}
    </ul>
    <p class="dab-note">This disambiguation page lists articles associated with the title <i>{page.title}</i>.</p>
    {history !== null && <p><a href={history}>View history</a></p>}
  </Layout>
)}